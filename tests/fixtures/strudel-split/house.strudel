// House sketch — C minor · 124 BPM · 6:27
// live-coder view: one idea per part. Edit + Ctrl+Enter re-renders the parts you changed.
setcpm(124/4)

const verse  = "<Cm7!2 Fm7!2>"
const chorus = "<Ab^7!2 Bbadd9!2>"
const chords = h => chord(h).voicing()
const drums  = stack(
  s("bd*4, [~ cp]*2, ~ ~ [~ [~ rim]] ~, [~ oh]*4"),
  s("[~ hh]*8").gain(.4),
  s("sh*2 sh*4").gain(perlin.range(.36, 1)),
).bank("RolandTR909").sometimesBy(.1, x => x.ply(2))
const bass   = n("~ 0 [~ 7] 0 ~ 7 [~ 4] 7".add("<5!2 6!2>")).scale("C2:minor").s("pluck-bass")
const stabs  = h => chords(h).struct("x(3,8) [[~ x] x]").s("sawtooth").adsr(".002:.25:.1:.12").lpf(1400).lpq(3).lpenv(2.5).lpattack(.005).lpdecay(.15).lpsustain(.1).lprelease(.1).delay(.2).delayfeedback(.3).room(.2).size(3)
const pad    = h => chords(h).s("square").adsr(".35:1:.9:.9").lpf(2600).vib(5).vibmod(.05).room(.4).size(5)
const lead   = n("<[5 ~@2 4@2 ~ 3 ~ 2@2 ~ 2@3 ~@2] [5@2 ~ 4@2 ~ 2@5 ~@5]>").scale("C4:minor").s("piano").adsr(".001:.05:1:.25").hpf(180).delay(.15).delayfeedback(.3).room(.2).size(2)
const arp    = h => chords(h).arp("[0 2 1 3 2 4 3 5]*2").transpose(12).s("triangle").adsr(".002:.22:0:.12").lpf(1600).lpenv(3).lpattack(.005).lpdecay(.12).lpsustain(0).lprelease(.1).delay(.35).delayfeedback(.45).room(.2).size(3)
const fx     = n("<2 ~!3>").scale("C3:minor").s("white").adsr("1.5:.5:1:1").lpf(500).lpq(4).lpenv(4.5).lpattack(2).lpdecay(.5).lpsustain(1).lprelease(.1).room(.5).size(6).delay(.2)
const percussion = s("[~ tb]*2, [~ [~ perc]] [~ perc]*2").bank("RolandTR909").sometimesBy(.1, x => x.ply(2))
const sub    = n("<[~@2 -2@2 ~ -2@3 ~@2 -2@2 ~ 2 -2@2] [[~ -2]*4] [~@2 -1@2 ~ -1@3 ~@2 -1@2 ~ 3 -1@2] [[~ -1]*4]>").scale("C1:minor").s("sine").adsr(".005:.3:.9:.1").lpf(400)
const counter = n("<[5 ~ 2 2 ~@2 4 4] [~@2 2 2 4 4 4 ~] [~ 3 1 1 ~@2 1 1] [~ 1 1 ~ 1 1 ~ 1]>").scale("C3:minor").s("triangle").adsr(".002:.22:0:.12").lpf(1600).lpenv(3).lpattack(.005).lpdecay(.12).lpsustain(0).lprelease(.1).delay(.35).delayfeedback(.45).room(.2).size(3)
const organ  = n("~").scale("C4:minor").s("gm_drawbar_organ").adsr(".005:.05:1:.12").room(.15).size(3)
const vocal_chops = n("[~@3 4 ~@2 4 ~@2 4 ~@2 5@2 ~@2]").scale("C4:minor").s("sawtooth").adsr(".003:.14:.35:.08").lpf(3200).hpf(250).vowel("o").delay(.25).delayfeedback(.35).room(.2).size(3)
const vox    = organ.s("sawtooth").adsr(".12:.4:.8:1").lpf(2800).vib(4.5).vibmod(.06).vowel("o").room(.55).size(6).delay(.1)
const texture = n("<9 7 8 6>").scale("C4:minor").s("supersaw").adsr("1.2:1:.9:2.5").lpf(1500).unison(3).detune(.1).spread(1).room(.75).size(9)
const impacts = s("bd, lt, cr").bank("RolandR8")

$: arrange(
  [16, drums.lpf(saw.rangex(380, 16000).slow(16)).degradeBy(.4)],               // intro
  [16, stack(drums.lpf(saw.rangex(380, 16000).slow(16)), bass, fx, sub,         // intro 2
    texture)],
  [16, stack(drums, bass, stabs(verse), percussion, sub, vocal_chops)],         // groove
  [16, stack(stack(stabs(chorus).struct("x"), pad(chorus).gain(.6)).lpf(saw.rangex(1800, 12000).slow(16)),  // breakdown
    lead.degradeBy(.4), fx, vox.gain(.6))],
  [8, stack(drums, stabs(chorus).lpf(sine.rangex(3700, 16000).slow(8)),         // build
    arp(chorus).lpf(saw.rangex(450, 16000).slow(8)), fx, percussion, vocal_chops)],
  [32, stack(drums, bass, stabs(chorus), pad(chorus), lead, percussion, sub,    // drop
    counter, organ, vox.mask("<0!16 1!16>"), impacts)],
  [16, stack(drums, bass, stabs(verse), pad(verse), percussion, sub, organ,     // groove 2
    vocal_chops.mask("<0!8 1!8>"))],
  [8, stack(stabs(chorus).lpf(sine.rangex(1800, 16000).slow(8)).struct("x"),    // breakdown 2
    pad(chorus).lpf(saw.rangex(1800, 12000).slow(8)).gain(.7),
    lead.lpf(saw.rangex(510, 16000).slow(8)).degradeBy(.4), vox.gain(.6))],
  [8, stack(drums, stabs(chorus).lpf(sine.rangex(3700, 16000).slow(8)),         // build 2
    arp(chorus).lpf(saw.rangex(450, 16000).slow(8)), fx, percussion, vocal_chops)],
  [32, stack(drums, bass, stabs(chorus), pad(chorus), lead, fx, percussion, sub,  // drop 2
    counter, organ, vox.mask("<0!16 1!16>"), impacts)],
  [16, stack(drums.degradeBy(.5), bass, stabs(chorus).struct("x"), sub,         // outro
    texture)],
  [16, drums.degradeBy(.5)],                                                    // outro 2
)

