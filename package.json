{
  "name": "daw3",
  "version": "1.0.0",
  "description": "it was always here.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "mac:dev": "electron .",
    "mac:build": "sh desktop/native/build.sh && electron-builder --mac --arm64 --publish never && electron-builder --mac --x64 --publish never && sh scripts/make-dmg.sh",
    "mac:icon": "node scripts/make-icon.mjs",
    "native:build": "sh desktop/native/build.sh",
    "native:test": "sh desktop/native/build.sh --test"
  },
  "license": "AGPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "author": "Coral-coder",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coralcoder.daw3",
    "productName": "daW3",
    "copyright": "AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "vendor/**/*",
      "desktop/**/*",
      "build/icon.png",
      "LICENSE",
      "package.json",
      "!desktop/native/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "daW³ uses the microphone (or your audio interface) to record audio into your project.",
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "dmg": {
      "title": "daW3 ${version}",
      "artifactName": "daW3-${version}-${arch}.dmg"
    },
    "fileAssociations": [
      {
        "ext": [
          "daW3",
          "daw3"
        ],
        "name": "daW³ Project",
        "description": "daW³ project",
        "role": "Editor",
        "mimeType": "application/x-daw3"
      }
    ],
    "extraResources": [
      {
        "from": "desktop/native/build",
        "to": "native",
        "filter": [
          "daw3_audio.node",
          "daw3-plughost"
        ]
      }
    ],
    "asarUnpack": [
      "src/native/**"
    ]
  }
}
