{
  "name": "daw3",
  "version": "1.0.0",
  "description": "it was always here.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "mac:dev": "electron .",
    "mac:build": "electron-builder --mac --publish never",
    "mac:icon": "node scripts/make-icon.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "author": "Coral-coder",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coralcoder.daw3",
    "productName": "daW3",
    "copyright": "AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "vendor/**/*",
      "desktop/**/*",
      "build/icon.png",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "daW³ uses the microphone (or your audio interface) to record audio into your project.",
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "dmg": {
      "title": "daW3 ${version}",
      "artifactName": "daW3-${version}-${arch}.dmg"
    },
    "fileAssociations": [
      {
        "ext": [
          "daW3",
          "daw3"
        ],
        "name": "daW³ Project",
        "description": "daW³ project",
        "role": "Editor",
        "mimeType": "application/x-daw3"
      }
    ]
  }
}
