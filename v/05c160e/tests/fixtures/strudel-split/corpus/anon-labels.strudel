// Anonymous $: blocks, n().scale(), a swept acid bass, perlin-ridden keys
setcpm(124/4)
// drums
$: s("bd*4, [~ cp]*2, hh*8").bank("RolandTR909").gain(".9 .6")
// bassline
$: n("0 [~ 0] 3 [~ 5]").scale("C2:minor").s("sawtooth").lpf(sine.range(400, 2000).slow(4)).lpq(8).decay(.15).sustain(0)
// keys
$: chord("<Cm9 Fm9 Ab^7 G7>").voicing().s("gm_epiano1").room(.5).size(4).gain(perlin.range(.4, .7))
